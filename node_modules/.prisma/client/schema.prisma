datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  email             String?
  role              String   @default("BUYER") // BUYER, ARTISAN, ADMIN
  displayName       String
  photoUrl          String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions           AuthSession[]
  artisanProfile     ArtisanProfile?
  enquiriesAsBuyer   EnquiryThread[] @relation("BuyerEnquiries")
  messages           Message[]
  commissionsAsBuyer Commission[]    @relation("BuyerCommissions")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArtisanProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  displayName              String
  title                    String?
  craftCategories          String // JSON array: ["pottery_clay", "terracotta"]
  regionalCluster          String
  state                    String
  district                 String
  village                  String?
  lineageYears             String?
  guildStatus              String   @default("VERIFIED_MASTER") // PENDING, VERIFIED_MASTER, NATIONAL_AWARDEE
  giTagNumber              String?
  workshopStatus           String   @default("ACTIVE_KILN")
  bio                      String?
  voiceDialect             String?
  audioBioUrl              String?
  maskWorkshopGps          Boolean  @default(true)
  allowWhatsAppInquiries   Boolean  @default(true)
  showArtisanApprovedBadge Boolean  @default(true)
  bankAccountDetails       String? // Encrypted/JSON (hidden from buyer responses)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  productDrafts        ProductDraft[]
  videoJobs            VideoProcessingJob[]
  enquiries            EnquiryThread[]       @relation("ArtisanEnquiries")
  commissions          Commission[]          @relation("ArtisanCommissions")
  priceRecommendations PriceRecommendation[]
}

model ProductDraft {
  id                      String   @id @default(uuid())
  artisanId               String
  title                   String?
  category                String?
  craftType               String?
  rawMaterials            String? // JSON array
  dimensions              String? // JSON object: { height, width, diameter, weight }
  makerPrice              Float?
  buyerPrice              Float?
  stockReady              Int      @default(1)
  leadTimeDays            Int      @default(3)
  careInstructions        String?
  status                  String   @default("DRAFT") // DRAFT, VIDEO_UPLOADED, AI_PROCESSED, APPROVED
  pricingRecommendationId String?
  pricingInputs           String? // JSON object
  recommendedPrice        Float?
  finalPrice              Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  artisan               ArtisanProfile       @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  videoJobs             VideoProcessingJob[]
  product               Product?
  pricingRecommendation PriceRecommendation? @relation(fields: [pricingRecommendationId], references: [id], onDelete: SetNull)
}

model Product {
  id                      String   @id @default(uuid())
  artisanId               String
  draftId                 String?  @unique
  title                   String
  category                String
  craftType               String
  craftDiscipline         String?
  description             String
  rawMaterials            String // JSON array
  dimensions              String // JSON object
  makerPrice              Float
  buyerPrice              Float
  stockReady              Int      @default(1)
  leadTimeDays            Int      @default(2)
  careInstructions        String?
  giRegistryNumber        String?
  status                  String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  images                  String // JSON array of image objects
  tags                    String // JSON array
  translations            String? // JSON translations: { hi, mr, bn }
  pricingRecommendationId String?
  pricingInputs           String? // JSON object
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  artisan               ArtisanProfile       @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  draft                 ProductDraft?        @relation(fields: [draftId], references: [id], onDelete: SetNull)
  enquiries             EnquiryThread[]
  commissions           Commission[]
  pricingRecommendation PriceRecommendation? @relation(fields: [pricingRecommendationId], references: [id], onDelete: SetNull)
}

model VideoProcessingJob {
  id                 String   @id @default(uuid())
  artisanId          String
  productDraftId     String
  videoUrl           String
  fileSizeBytes      Int?
  durationSeconds    Float?
  stage              String   @default("UPLOADED") // UPLOADED, EXTRACTING, SCORING, SELECTING, COMPLETED, FAILED
  progressPercentage Int      @default(0)
  totalFrames        Int      @default(0)
  framesScored       Int      @default(0)
  detections         String? // JSON object: { craftLineage, glazeScore, lightingScore }
  candidateFrames    String? // JSON array of extracted frames
  selectedImages     String? // JSON array of approved images
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  draft   ProductDraft   @relation(fields: [productDraftId], references: [id], onDelete: Cascade)
}

model PriceRecommendation {
  id                   String   @id @default(uuid())
  draftId              String?
  productId            String?
  artisanId            String
  productCategory      String
  craftType            String?
  materialCost         Float
  labourHours          Float    @default(0)
  labourHourlyRate     Float    @default(0)
  labourCost           Float
  packagingCost        Float
  overheadCost         Float
  shippingCost         Float    @default(0)
  shippingPayer        String   @default("BUYER") // BUYER, ARTISAN
  baseProductionCost   Float
  desiredMarginPct     Float
  markupPct            Float    @default(0)
  minViablePrice       Float
  recommendedPrice     Float
  premiumPrice         Float
  marketMedianPrice    Float?
  marketRangeLow       Float?
  marketRangeHigh      Float?
  comparableCount      Int      @default(0)
  confidenceScore      Float    @default(0.5) // 0.0 - 1.0
  marketFreshness      DateTime @default(now())
  lossRiskFlag         Boolean  @default(false)
  artisanSelectedPrice Float?
  explanation          String
  costBreakdown        String // JSON string
  comparableListings   String? // JSON string
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  drafts   ProductDraft[]
  products Product[]
}

model MarketBenchmark {
  id                  String   @id @default(uuid())
  category            String
  craftType           String
  material            String
  craftGrade          String   @default("MASTER_ARTISAN") // ENTRY_HANDMADE, MASTER_ARTISAN, GI_CERTIFIED_HERITAGE
  region              String?
  typicalLabourHours  Float?
  priceMin            Float
  priceMedian         Float
  priceMax            Float
  sampleSize          Int      @default(10)
  sourceName          String   @default("Kala Connect Verified Craft Index")
  isHandmadeCertified Boolean  @default(true)
  notes               String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model EnquiryThread {
  id        String   @id @default(uuid())
  productId String
  buyerId   String
  artisanId String
  status    String   @default("OPEN") // OPEN, COMMISSION_REQUESTED, CLOSED
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer    User           @relation("BuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  artisan  ArtisanProfile @relation("ArtisanEnquiries", fields: [artisanId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id              String   @id @default(uuid())
  threadId        String
  senderId        String
  text            String
  audioNoteUrl    String?
  detectedDialect String?
  translatedText  String?
  attachments     String? // JSON array of { type, url }
  createdAt       DateTime @default(now())

  thread EnquiryThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Commission {
  id                String   @id @default(uuid())
  orderNumber       String   @unique
  buyerId           String
  artisanId         String
  productId         String
  totalEscrowAmount Float
  amountDisbursed   Float    @default(0)
  amountInEscrow    Float
  customDimensions  String?
  weaveDensity      String?
  weatherAdvisory   String? // JSON object: { status, note }
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, REFUNDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  buyer         User           @relation("BuyerCommissions", fields: [buyerId], references: [id], onDelete: Cascade)
  artisan       ArtisanProfile @relation("ArtisanCommissions", fields: [artisanId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  milestones    Milestone[]
  ledgerEntries EscrowLedger[]
}

model Milestone {
  id                String    @id @default(uuid())
  commissionId      String
  stageNumber       Int // 1, 2, 3, 4, 5
  title             String
  percentage        Float // 20, 20, 30, 15, 15
  amount            Float
  status            String    @default("PENDING") // PENDING, IN_PROGRESS, PROOF_SUBMITTED, DISBURSED
  proofPhotoUrl     String?
  proofAudioMemoUrl String?
  artisanNotes      String?
  disbursedAt       DateTime?

  commission    Commission     @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  ledgerEntries EscrowLedger[]
}

model EscrowLedger {
  id              String   @id @default(uuid())
  commissionId    String
  milestoneId     String?
  transactionType String // DEPOSIT, DISBURSEMENT, REFUND
  amount          Float
  description     String
  reference       String?
  createdAt       DateTime @default(now())

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  milestone  Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
}
