{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "stitch_kala_connect_artisan_marketplace 2"
    },
    "app": {
      "root": ".",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "optimizer-service",
          "format": "url",
          "env": "OPTIMIZER_SERVICE_URL"
        }
      ]
    },
    "optimizer-service": {
      "root": "optimizer-service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
